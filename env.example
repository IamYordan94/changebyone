# Neon Database Connection String
# Get your connection string from your Neon project dashboard
# Format: postgresql://username:password@host.neon.tech/dbname?sslmode=require
# 
# Copy this file to .env.local and fill in your actual connection string:
# cp env.example .env.local
DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require

# Site URL for SEO (Open Graph, sitemap, etc.)
# Use your production domain URL
NEXT_PUBLIC_SITE_URL=https://changebyone.vercel.app

